# ---- Gemini ----
GEMINI_API_KEY=GEMINI_API_KEY_HERE
GEMINI_EMBED_MODEL=models/gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_GEN_MODEL=models/gemini-3.6-flash
GEMINI_JUDGE_MODEL=models/gemini-3.6-flash

# ---- Database ----
# db/database.py builds the connection string from these four values —
# don't also set DATABASE_URL here, or it can silently diverge from
# POSTGRES_DB and cause a "database does not exist" error.
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- App ----
APP_ENV=development
UPLOAD_DIR=/app/data/uploaded_docs
MAX_UPLOAD_FILES=10
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_SIMILARITY=0.55
